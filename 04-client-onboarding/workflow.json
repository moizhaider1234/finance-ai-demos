          "__rl": true,
          "mode": "url",
          "value": "PASTE_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Onboarding Tasks"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        }
      }
    },
    {
      "id": "b12e0080-7b1a-45dd-986b-72bccd8f8b9b",
      "name": "Build task rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        150
      ],
      "parameters": {
        "jsCode": "const c = $('Normalize intake').item.json;\nconst steps = ['Review signed engagement letter', 'Confirm bank feeds / software access', 'Receive first documents', 'Kickoff call', 'First month bookkeeping start'];\nreturn steps.map((s, i) => ({ json: { client: c.client, task: s, owner: 'Bookkeeper', status: 'Open', due_in_days: [2, 3, 5, 5, 10][i], created: new Date().toISOString() } }));"
      }
    },
    {
      "id": "f0569392-dcd5-4518-a303-138463f43237",
      "name": "Note 11",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        220
      ],
      "parameters": {
        "content": "Create a Google Doc template using the placeholders in engagement_letter_template.md. 'Copy template' runs once per client (connect from the folder node).",
        "height": 140,
        "width": 360
      }
    }
