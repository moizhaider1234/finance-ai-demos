    {
      "id": "e867e9d3-6c47-4c95-a459-8bc28e312cf4",
      "name": "Score + personalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const j = $json;\nconst Q = [\n  ['Invoices and receipts are entered by hand', 'Invoice entry', 'Automate invoice capture: extract vendor, date, tax and total from PDFs and auto-suggest categories, with a human review queue for low-confidence items.'],\n  ['Bank reconciliation takes more than a day each month', 'Bank reconciliation', 'Auto-match bank lines to ledger entries on amount, date window and description; review only the exceptions.'],\n  ['Overdue invoices are chased manually', 'Receivables chasing', 'Set tiered reminders (friendly, firm, final) that stop when an invoice is marked paid, plus a weekly summary to the owner.'],\n  ['New client onboarding uses a manual checklist', 'Client onboarding', 'One intake form that creates folders, fills the engagement letter, emails the document checklist and creates tasks.'],\n  ['Clients ask the same questions repeatedly', 'Client FAQs', 'A document-grounded assistant that answers routine questions, hands unclear ones to your team and declines to give tax advice.'],\n  ['Monthly reports are built by hand in spreadsheets', 'Monthly reporting', 'Generate the calculations, a plain-English summary and a PDF from your monthly figures, then draft the client email.'],\n  ['Documents are collected over email chains', 'Document collection', 'Send a standard checklist per client type and track what has arrived in one shared sheet.']\n];\nconst val = { 'Never': 0, 'Sometimes': 1, 'Always': 2 };\nconst rated = Q.map(([q, area, advice]) => ({ area, advice, v: val[j[q]] ?? 0 }));\nconst raw = rated.reduce((a, r) => a + r.v, 0);\nconst score = Math.round((raw / (Q.length * 2)) * 100);\nconst tier = score >= 60 ? 'High opportunity' : score >= 30 ? 'Medium opportunity' : 'Low opportunity';\nconst headline = score >= 60 ? 'A lot of your week is likely going on repeatable manual work. Start with your top two items below.'\n  : score >= 30 ? 'You have a few clear automation wins. Start with the first item below.'\n  : 'Your processes are already fairly streamlined. The items below are optional polish.';\nconst actions = rated.filter(r => r.v > 0).sort((a, b) => b.v - a.v);\nif (actions.length === 0) actions.push({ area: 'Review', advice: 'Re-run this AUDIT in three months or when your client count grows.', v: 0 });\nreturn { json: { name: j['Name'], email: j['Email'], firm: j['Firm name'] || '', score, tier, headline, actions: actions.map(({ area, advice }) => ({ area, advice })) } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "d64ecdc8-13cd-4420-9cac-4e1327eb0bec",
      "name": "Build checklist HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const s = $json;\nconst items = s.actions.map(a => `<li><b>${a.area}</b>: ${a.advice}</li>`).join('');\nconst html = `<html><body style=\"font-family:Helvetica,Arial;margin:40px;color:#222\"><h1>Your Automation AUDIT</h1><p>Hi ${s.name}${s.firm ? ' (' + s.firm + ')' : ''},</p>\n<p><b>Automation opportunity score: ${s.score}/100 (${s.tier})</b></p><p>${s.headline}</p><h2>Your priority checklist</h2><ol>${items}</ol><p style=\"color:#666\">This checklist is general guidance from a demo system, not financial or tax advice.</p></body></html>`;\nreturn { json: { ...s, html }, binary: { files: { data: Buffer.from(html).toString('base64'), mimeType: 'text/html', fileName: 'index.html' } } };",
        "mode": "runOnceForEachItem"
      }
    },
